{
  "mcpServers": {
    "task-master-ai": {
      "command": "npx",
      "args": ["-y", "task-master-ai"],
      "env": {
        "TASK_MASTER_TOOLS": "all",
        "ANTHROPIC_API_KEY": "",
        "OPENAI_API_KEY": "",
        "GOOGLE_API_KEY": "",
        "GROQ_API_KEY": "",
        "ARG_ENCRYPTION_KEY": "",
        "ENCRYPTION_KEY": "",
        "REALM_MASTER_KEY": "",
        "REALM_FORGE_API_KEY": "",
        "AI_GATEWAY_API_KEY": "",
        "ELEVENLABS_API_KEY": "",
        "IONOS_API_PUBLIC_PREFIX": "",
        "IONOS_API_SECRET": "",
        "LINEAR_API_KEY": "",
        "POSTGRES_URL": "",
        "POSTGRES_DB": "",
        "POSTGRES_HOST": "",
        "POSTGRES_PASSWORD": "",
        "POSTGRES_PORT": "5432",
        "POSTGRES_USER": "",
        "REDIS_URL": "",
        "CONTACT_EMAIL": "",
        "SMTP_USER": "",
        "SMTP_PASS": "",
        "SMTP_SERVER": "",
        "SMTP_PORT": "587",
        "IMAP_USER": "",
        "IMAP_PASS": "",
        "IMAP_SERVER": "",
        "STRIPE_API_KEY": "",
        "STRIPE_PUBLISHABLE_KEY": "",
        "STRIPE_WEBHOOK_SECRET": "",
        "STRIPE_TEST_MODE": "YES",
        "BACKEND_URL": "http://localhost:8000",
        "FRONTEND_URL": "http://localhost:5173",
        "ANALYTICS_ENABLED": "false",
        "TELEMETRY_ENABLED": "false",
        "OUTREACH_ENABLED": "false",
        "OUTREACH_DRY_RUN": "true",
        "DRY_RUN_MODE": "true",
        "TEST_MODE": "true",
        "ENV": "development",
        "LOG_LEVEL": "INFO",
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUTF8": "1",
        "VECTOR_STORE_PATH": "./data/vector_store",
        "TASK_QUEUE_MAX_SIZE": "1000",
        "CIRCUIT_BREAKER_THRESHOLD": "5",
        "RECOVERY_TIMEOUT": "30",
        "PROJECT_NAME": "Realms2Riches"
      }
    }
  }
}
