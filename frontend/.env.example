# API used by the Vite app (see src/lib/apiBase.js).
# In dev, leave unset to use same-origin + Vite proxy for /api, /assets, /marketing, /swarms.
# VITE_API_URL=http://localhost:8000

# Optional legacy alias (same effect as VITE_API_URL if set).
# VITE_BACKEND_URL=http://localhost:8000

# VITE_ANALYTICS_ENABLED=true
# VITE_SOVEREIGN_LICENSE_KEY=
