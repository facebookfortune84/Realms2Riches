VECTOR_STORE_PATH=./data/vector_store
LOG_LEVEL=INFO
ENV=PROD
PYTHONIOENCODING=utf-8
PYTHONUTF8=1
LOG_LEVEL=INFO

# --- UPLINK GATEWAY (NETWORKING) ---
# Aligned for Vercel Frontend <-> Render/Local Backend
BACKEND_URL=https://api.realms2riches.com

# --- CORE ---
FRONTEND_URL=https://realms2riches.com
# REALM_MASTER_KEY and ENCRYPTION_KEY should be strong, unique secrets.
# Generate these using a secure method or a crypto library for production.
REALM_MASTER_KEY=pk-change-me-to-a-secure-master-key-for-production
ENV_MODE=prod
BRAND_NAME=Realms 2 Riches
PRODUCT_NAME=Sovereign Swarm
MARKETING_SITE_URL=https://realms2riches.com
CONTACT_EMAIL=contact@realms2riches.com

# --- DATABASE ---
# PostgreSQL connection details for production.
# Ensure these match your Docker Compose configuration or deployment environment.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=swarm_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:change_me_to_a_strong_password@db:5432/swarm_db

# --- QUEUEING & CACHING ---
REDIS_URL=redis://redis:6379/0

# --- INTELLIGENCE (Groq / OpenAI) ---
# Set GROQ_API_KEY and OPENAI_API_KEY to your actual API keys.
# If a key is missing or set to a placeholder, the corresponding LLM provider may be unavailable.
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE # Obtain from Groq console
GROQ_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1

OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE # Obtain from OpenAI platform

# --- COMMUNICATION (EMAIL) ---
# For production, use a dedicated transactional email service (e.g., SendGrid, Mailgun)
# For local testing, configure a local SMTP server (e.g., mailhog) or a Gmail App Password.
SMTP_USER=realms2riches_outreach@gmail.Use_App_Password_Here
SMTP_PASS=YOUR_GMAIL_APP_PASSWORD_HERE # Use an App Password for Gmail SMTP
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465 # Typically 587 for TLS, 465 for SSL
IMAP_SERVER=imap.gmail.com
IMAP_USER=realms2riches_outreach@gmail.com
IMAP_PASS=YOUR_GMAIL_APP_PASSWORD_HERE # Use an App Password for Gmail IMAP

# --- MONETIZATION ---
# Stripe production keys and webhook secret. Use test keys for development.
STRIPE_API_KEY=sk_live_change_me_to_your_live_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_change_me_to_your_stripe_webhook_secret

# --- SOCIAL MEDIA ---
FACEBOOK_PAGE_ACCESS_TOKEN=YOUR_FB_PAGE_ACCESS_TOKEN
FACEBOOK_BUSINESS_ID=YOUR_FB_BUSINESS_ID
FACEBOOK_APP_ID=YOUR_FB_APP_ID
FACEBOOK_CLIENT_ID=YOUR_FB_CLIENT_ID
FACEBOOK_APP_SECRET=YOUR_FB_APP_SECRET
FACEBOOK_PAGE_ID=YOUR_FB_PAGE_ID
FACEBOOK_USER_TOKEN=YOUR_FB_USER_TOKEN
FACEBOOK_PAGE_TOKEN=YOUR_FB_PAGE_TOKEN

LINKEDIN_ACCESS_TOKEN=YOUR_LINKEDIN_ACCESS_TOKEN
LINKEDIN_CLIENT_ID=YOUR_LINKEDIN_CLIENT_ID
LINKEDIN_CLIENT_SECRET=YOUR_LINKEDIN_CLIENT_SECRET
LINKEDIN_PROFILE_URN=your_linkedin_profile_urn
LINKEDIN_REFRESH_TOKEN=your_linkedin_refresh_token

# --- REALMS2RICHES SPECIFIC ---
# These are critical for core functionality and MUST be replaced with secure values.
# Consult project documentation for generation methods or default values.
REALMS2RICHES_CORE_KEY=YOUR_SECURE_MASTER_KEY_HERE
REALM_FORGE_API_KEY=YOUR_FORGE_API_KEY_HERE
ARG_ENCRYPTION_KEY=YOUR_ARG_ENCRYPTION_KEY_HERE
ENCRYPTION_KEY=YOUR_ENCRYPTION_KEY_HERE

# --- SOCIAL MEDIA HANDLES ---
SOCIAL_TWITTER_HANDLE=@Realms2Riches
SOCIAL_LINKEDIN_URL=https://linkedin.com/company/realms2riches
SOCIAL_YOUTUBE_URL=https://youtube.com/c/realms2riches
SOCIAL_GITHUB_URL=https://github.com/realms2riches

# --- RELIABILITY & OBSERVABILITY ---
TELEMETRY_ENABLED=true
CIRCUIT_BREAKER_THRESHOLD=5
RECOVERY_TIMEOUT=60
TASK_QUEUE_MAX_SIZE=1000

