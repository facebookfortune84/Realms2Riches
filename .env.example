VECTOR_STORE_PATH=./data/vector_store or the path to your project vector_store here
LOG_LEVEL=INFO or Verbose
ENV=PROD or DEV
PYTHONIOENCODING=utf-8
PYTHONUTF8=1
LOG_LEVEL=INFO or Verbose

# --- UPLINK GATEWAY (NETWORKING) ---
# Aligned for Vercel Frontend <-> Render/Local Backend
BACKEND_URL=Your Domain URL Where Your Backend/API lives

# --- CORE ---
FRONTEND_URL=Your Frontend Domain URL
# REALM_MASTER_KEY and ENCRYPTION_KEY should be strong, unique secrets.
# Generate these using a secure method or a crypto library for production.
REALM_MASTER_KEY=pk-change-me-to-a-secure-master-key-for-production
ENV_MODE=prod or dev
BRAND_NAME=Your Brand Name Here
PRODUCT_NAME=Your Product Name Here
MARKETING_SITE_URL=Your Website Domain Where Marketing Material Will Live
CONTACT_EMAIL=Your Contact Email for the Project

# --- DATABASE ---
# PostgreSQL connection details for production.
# Ensure these match your Docker Compose configuration or deployment environment.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=Your Postgres_db Name Here
POSTGRES_HOST=Your loopback URL or Docker Host ID
POSTGRES_PORT=5432 or Your choice of Ports to Host the Postgres_db on when in Dev or Local Modes
DATABASE_URL=postgresql+asyncpg://postgres:change_me_to_a_strong_password@db:5432orYourPort#Here/Your Postgres_db Name Here

# --- QUEUEING & CACHING ---
REDIS_URL=redis://redis:6379/0 or Docker REDIS HOST ID

# --- INTELLIGENCE (Groq / OpenAI) ---
# Set GROQ_API_KEY and OPENAI_API_KEY to your actual API keys.
# If a key is missing or set to a placeholder, the corresponding LLM provider may be unavailable.
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE # Obtain from Groq console
GROQ_MODEL=llama-3.1-8b-instant or Your Choice of LLM Models Here
GROQ_BASE_URL=https://api.groq.com/openai/v1 or Your Groq Base URL Here

OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE # Obtain from OpenAI platform

# --- COMMUNICATION (EMAIL) ---
# For production, use a dedicated transactional email service (e.g., SendGrid, Mailgun)
# For local testing, configure a local SMTP server (e.g., mailhog) or a Gmail App Password.
SMTP_USER=YourCompanyHere_outreach@gmail.com or Your Professional Email Address Connecting to Your Domain URL Here
SMTP_PASS=YOUR_GMAIL_APP_PASSWORD_HERE # Use an App Password for Gmail SMTP
SMTP_SERVER=smtp.gmail.com (Leave this Alone Unless Using a Different Mail Host for SMTP)
SMTP_PORT=465 # Typically 587 for TLS, 465 for SSL
IMAP_SERVER=imap.gmail.com (Leave this Alone Unless Using a Different Mail Host for IMAP)
IMAP_USER=YourCompanyNameHere_outreach@gmail.com or Your Professional Email Address Connected to Your Domain URL
IMAP_PASS=YOUR_GMAIL_APP_PASSWORD_HERE # Use an App Password for Gmail IMAP

# --- MONETIZATION ---
# Stripe production keys and webhook secret. Use test keys for development.
STRIPE_API_KEY=sk_live_change_me_to_your_live_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_change_me_to_your_stripe_webhook_secret

# --- SOCIAL MEDIA ---
FACEBOOK_PAGE_ACCESS_TOKEN=YOUR_FB_PAGE_ACCESS_TOKEN
FACEBOOK_BUSINESS_ID=YOUR_FB_BUSINESS_ID
FACEBOOK_APP_ID=YOUR_FB_APP_ID
FACEBOOK_CLIENT_ID=YOUR_FB_CLIENT_ID
FACEBOOK_APP_SECRET=YOUR_FB_APP_SECRET
FACEBOOK_PAGE_ID=YOUR_FB_PAGE_ID
FACEBOOK_USER_TOKEN=YOUR_FB_USER_TOKEN
FACEBOOK_PAGE_TOKEN=YOUR_FB_PAGE_TOKEN

LINKEDIN_ACCESS_TOKEN=YOUR_LINKEDIN_ACCESS_TOKEN
LINKEDIN_CLIENT_ID=YOUR_LINKEDIN_CLIENT_ID
LINKEDIN_CLIENT_SECRET=YOUR_LINKEDIN_CLIENT_SECRET
LINKEDIN_PROFILE_URN=your_linkedin_profile_urn
LINKEDIN_REFRESH_TOKEN=your_linkedin_refresh_token

# --- REALMS2RICHES SPECIFIC ---
# These are critical for core functionality and MUST be replaced with secure values.
# Consult project documentation for generation methods or default values.
YOURPROJECTNAME_CORE_KEY=YOUR_SECURE_MASTER_KEY_HERE
YOURPROJECTNAME_API_KEY=YOUR_PROJECT_API_KEY_HERE
ARG_ENCRYPTION_KEY=YOUR_ARG_ENCRYPTION_KEY_HERE
ENCRYPTION_KEY=YOUR_ENCRYPTION_KEY_HERE

# --- SOCIAL MEDIA HANDLES ---
SOCIAL_TWITTER_HANDLE=@YourTwitterHandle Here
SOCIAL_LINKEDIN_URL=https://linkedin.com/in/yourlinkedinuserorpageidhere
SOCIAL_YOUTUBE_URL=https://youtube.com/c/thenameofyouryoutubechannelhere
SOCIAL_GITHUB_URL=https://github.com/yourgithubusernamehere/yourgithubreponamehere

# --- RELIABILITY & OBSERVABILITY ---
TELEMETRY_ENABLED=true or false
CIRCUIT_BREAKER_THRESHOLD=5 or whatever number you decide is correct for your project here
RECOVERY_TIMEOUT=60 or whatever recovery timeout length in seconds here
TASK_QUEUE_MAX_SIZE=1000 or whatever you want your max task queue size to be here

# --- TASK MASTER (task-master-ai / Cursor MCP) ---
# Used by Task Master CLI and the task-master-ai MCP server for PRD parsing, research, and task expansion.
# Add whichever providers you use; remove unused keys from .cursor/mcp.json env as well.

OLLAMA_API_KEY=your_ollama_api_key_here
GITHUB_API_KEY=your_github_api_key_here
